{
  "name": "pochini",
  "private": true,
  "version": "0.14.3",
  "description": "Click and keyboard macros for Windows, driven by screen coordinates and global hotkeys",
  "license": "MIT",
  "author": "Jigglyy",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jigglyy/pochini.git"
  },
  "homepage": "https://github.com/Jigglyy/pochini",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "release": "node scripts/release.mjs",
    "notices": "node scripts/notices.mjs",
    "typecheck": "tsc && tsc --noEmit -p e2e/tsconfig.json",
    "guards": "node scripts/guards.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run guards && vitest run && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "pree2e": "tsc --noEmit -p e2e/tsconfig.json && tauri build --debug --no-bundle",
    "e2e": "playwright test",
    "pree2e:headed": "tsc --noEmit -p e2e/tsconfig.json && tauri build --debug --no-bundle",
    "e2e:headed": "playwright test --headed",
    "icons": "tauri icon assets/pochini-icon.svg && node -e \"for (const d of ['android','ios']) require('node:fs').rmSync('src-tauri/icons/'+d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "~2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "~2.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
